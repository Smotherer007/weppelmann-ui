{
  "color": {
    "$type": "color",
    "bg": {
      "canvas": {
        "$value": "#0A0A0A"
      },
      "panel": {
        "$value": "#121212"
      },
      "raised": {
        "$value": "#1A1A1A"
      },
      "input": {
        "$value": "#101010"
      },
      "hover": {
        "$value": "#202020"
      },
      "selected": {
        "$value": "#2A2A2A"
      }
    },
    "border": {
      "subtle": {
        "$value": "#2B2B2B"
      },
      "strong": {
        "$value": "#4E4E4E"
      }
    },
    "text": {
      "default": {
        "$value": "#EDEDED"
      },
      "muted": {
        "$value": "#A6A6A6"
      },
      "faint": {
        "$value": "#8C8C8C"
      },
      "on-accent": {
        "$value": "#0A0A0A"
      }
    },
    "accent": {
      "default": {
        "$value": "#EDEDED"
      },
      "hover": {
        "$value": "#FFFFFF"
      },
      "pressed": {
        "$value": "#B4B4B4"
      }
    },
    "status": {
      "ok": {
        "$value": "#A6A6A6"
      },
      "warn": {
        "$value": "#D9D9D9"
      },
      "error": {
        "$value": "#FFFFFF"
      }
    },
    "focus": {
      "ring": {
        "$value": "#FFFFFF"
      }
    }
  }
}

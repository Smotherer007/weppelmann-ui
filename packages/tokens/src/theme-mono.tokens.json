{
  "color": {
    "$type": "color",
    "bg": {
      "canvas": {
        "$value": "#0A0A0A"
      },
      "panel": {
        "$value": "#101010"
      },
      "raised": {
        "$value": "#161616"
      },
      "input": {
        "$value": "#0D0D0D"
      },
      "hover": {
        "$value": "#1E1E1E"
      },
      "selected": {
        "$value": "#262626"
      }
    },
    "border": {
